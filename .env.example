# Скопируй этот файл в .env и впиши свои значения (после изменения перезапусти npm run dev)

# Telegram-бот (создаётся в @BotFather)
VITE_TOKEN=
# ID чата админа (узнать можно у @userinfobot). Заказы, поддержка и чат по кастомной мебели придут сюда
VITE_USER_ID=

# MockAPI: пользователи (необязательно — без него аккаунты хранятся в localStorage)
VITE_USERS_API=
# MockAPI: товары (необязательно — без него берётся src/data/products.js)
VITE_PRODUCTS_API=
